{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "localization-core-filament",
  "display_name": "Localization Filament",
  "description": "Localization filament presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\LocalizationCoreFilament\\LocalizationCoreFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/localization-core": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.localization-core.filament"
  ],
  "default_enabled": true,
  "features": [
    "Bounded filament presentation for Localization",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ],
  "presentation": {
    "filament": {
      "admin": [
        "Liberu\\Foundation\\LocalizationCoreFilament\\LocalizationCoreFilamentPlugin"
      ]
    }
  }
}
