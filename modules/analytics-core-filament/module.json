{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "analytics-core-filament",
  "display_name": "Analytics Core Filament",
  "description": "Analytics Core filament presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\AnalyticsCoreFilament\\AnalyticsCoreFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/analytics-core": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.analytics-core.filament"
  ],
  "default_enabled": true,
  "features": [
    "Bounded filament presentation for Analytics Core",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ],
  "presentation": {
    "filament": {
      "admin": [
        "Liberu\\Foundation\\AnalyticsCoreFilament\\AnalyticsCoreFilamentPlugin"
      ]
    }
  }
}
