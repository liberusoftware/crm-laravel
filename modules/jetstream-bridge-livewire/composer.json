{
  "name": "liberusoftware/jetstream-bridge-livewire",
  "description": "Jetstream Bridge livewire presentation adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "livewire/livewire": "^4.0",
    "liberusoftware/jetstream-bridge": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\JetstreamBridgeLivewire\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "jetstream-bridge-livewire"
    },
    "support": {
      "source": "https://github.com/liberusoftware/module-jetstream-bridge-livewire"
    }
  },
  "version": "1.0.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\JetstreamBridgeLivewire\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
