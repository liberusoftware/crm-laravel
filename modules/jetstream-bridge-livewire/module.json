{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "jetstream-bridge-livewire",
  "display_name": "Jetstream Bridge Livewire",
  "description": "Jetstream Bridge livewire presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\JetstreamBridgeLivewire\\JetstreamBridgeLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/jetstream-bridge": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.jetstream-bridge.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Bounded livewire presentation for Jetstream Bridge",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}
