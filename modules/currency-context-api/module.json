{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "currency-context-api",
  "display_name": "Currency Context Api",
  "description": "Currency Context api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\CurrencyContextApi\\CurrencyContextApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
