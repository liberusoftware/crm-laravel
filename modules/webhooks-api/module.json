{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "webhooks-api",
  "display_name": "Webhooks Api",
  "description": "Webhooks api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\WebhooksApi\\WebhooksApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/webhooks": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.webhooks.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for Webhooks",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

