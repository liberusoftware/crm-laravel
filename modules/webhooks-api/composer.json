{
  "name": "liberusoftware/webhooks-api",
  "description": "Webhooks api presentation adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.38.0",
    "illuminate/routing": "^13.38.0",
    "liberusoftware/webhooks": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\WebhooksApi\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "webhooks-api"
    }
  },
  "version": "1.0.2",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\WebhooksApi\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.3.3"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "support": {
    "source": "https://github.com/liberusoftware/module-foundation-webhooks-api"
  }
}
