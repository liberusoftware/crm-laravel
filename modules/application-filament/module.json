{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "application-filament",
  "display_name": "Application Core Filament",
  "description": "Application Core filament presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\ApplicationFilament\\ApplicationFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/application": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.application.filament"
  ],
  "default_enabled": true,
  "features": [
    "Bounded filament presentation for Application Core",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ],
  "presentation": {
    "filament": {
      "admin": [
        "Liberu\\Foundation\\ApplicationFilament\\ApplicationFilamentPlugin"
      ]
    }
  }
}
