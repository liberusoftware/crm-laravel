{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "audit-filament",
  "display_name": "Audit Filament",
  "description": "Audit filament presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\AuditFilament\\AuditFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/audit": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.audit.filament"
  ],
  "default_enabled": true,
  "features": [
    "Bounded filament presentation for Audit",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ],
  "presentation": {
    "filament": {
      "admin": [
        "Liberu\\Foundation\\AuditFilament\\AuditFilamentPlugin"
      ]
    }
  }
}
