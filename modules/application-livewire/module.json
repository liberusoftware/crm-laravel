{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "application-livewire",
  "display_name": "Application Core Livewire",
  "description": "Application Core livewire presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\ApplicationLivewire\\ApplicationLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/application": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.application.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Bounded livewire presentation for Application Core",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}
