{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "feature-flags-livewire",
  "display_name": "Feature Flags Livewire",
  "description": "Feature Flags livewire presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\FeatureFlagsLivewire\\FeatureFlagsLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/feature-flags": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.feature-flags.livewire"
  ],
  "default_enabled": true,
