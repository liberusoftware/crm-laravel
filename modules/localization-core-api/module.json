{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "localization-core-api",
  "display_name": "Localization Api",
  "description": "Localization api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\LocalizationCoreApi\\LocalizationCoreApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/localization-core": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.localization-core.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for Localization",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

