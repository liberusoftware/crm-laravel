{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "audit-livewire",
  "display_name": "Audit Livewire",
  "description": "Audit livewire presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\AuditLivewire\\AuditLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/audit": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.audit.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Bounded livewire presentation for Audit",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}
