{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "feature-flags-filament",
  "display_name": "Feature Flags Filament",
  "description": "Feature Flags filament presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\FeatureFlagsFilament\\FeatureFlagsFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/feature-flags": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.feature-flags.filament"
  ],
  "default_enabled": true,
  "features": [
    "Bounded filament presentation for Feature Flags",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ],
  "presentation": {
    "filament": {
      "admin": [
        "Liberu\\Foundation\\FeatureFlagsFilament\\FeatureFlagsFilamentPlugin"
      ]
    }
  }
}
