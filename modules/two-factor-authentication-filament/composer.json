{
  "name": "liberusoftware/two-factor-authentication-filament",
  "description": "Two-Factor Authentication filament presentation adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "filament/filament": "^5.1",
    "liberusoftware/two-factor-authentication": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\TwoFactorAuthenticationFilament\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "two-factor-authentication-filament"
    },
    "support": {
      "source": "https://github.com/liberusoftware/module-two-factor-authentication-filament"
    }
  },
  "version": "1.0.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\TwoFactorAuthenticationFilament\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
