{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "api-access-api",
  "display_name": "API Access Api",
  "description": "API Access api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\ApiAccessApi\\ApiAccessApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/api-access": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.api-access.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for API Access",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

