{
  "name": "liberusoftware/scheduler-queues-api",
  "description": "Scheduler and Queues api presentation adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "liberusoftware/scheduler-queues": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\SchedulerQueuesApi\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "scheduler-queues-api"
    },
    "support": {
      "source": "https://github.com/liberusoftware/module-scheduler-queues-api"
    }
  },
  "version": "1.0.0",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\SchedulerQueuesApi\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}

