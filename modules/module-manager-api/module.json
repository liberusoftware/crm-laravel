{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "module-manager-api",
  "display_name": "Module Manager Api",
  "description": "Module Manager api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\ModuleManagerApi\\ModuleManagerApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-manager": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.module-manager.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for Module Manager",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

