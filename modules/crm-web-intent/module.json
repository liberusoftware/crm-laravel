{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "crm-web-intent",
  "display_name": "CRM Web Intent",
  "description": "First-party visits, identification, engagement, scoring, alerts, consent, and conversion.",
  "version": "1.0.0",
  "category": "capability",
  "provider": "Liberu\\CRM\\WebIntent\\WebIntentServiceProvider",
  "requires": { "php": "^8.5", "laravel": "^13.0", "packages": { "liberusoftware/module-manager": "^1.0" } },
  "suggests": { "liberusoftware/module-crm-web-intent-api": "^1.0", "liberusoftware/module-crm-web-intent-filament": "^1.0", "liberusoftware/module-crm-web-intent-livewire": "^1.0" },
  "capabilities": ["crm.web-intent"],
  "default_enabled": true,
  "features": ["First-party visits", "Account identification adapters", "Page and content engagement", "Scoring signals", "Alerts", "Buyer intent", "Consent", "Lead and account conversion"]
