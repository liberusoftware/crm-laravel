{
    "name": "crm-data-operations",
    "version": "1.0.0",
    "display_name": "CRM Data Operations",
    "description": "CRM imports, exports, data quality, enrichment, deduplication, schedules, and exception queues.",
    "category": "capability",
    "provider": "Liberu\\CRM\\DataOperations\\DataOperationsServiceProvider",
    "requires": {"php": "^8.5", "laravel": "^13.0", "packages": {"liberusoftware/module-manager": "^1.0", "liberusoftware/module-crm-core": "^1.0"}, "capabilities": {"crm.core.records": "^1.0"}},
    "capabilities": ["crm.data-operations.run"],
    "features": ["Imports and exports", "Field mapping", "Normalization", "Enrichment orchestration", "Duplicate detection and merge", "Formatting", "Quality rules", "Schedules", "Exception queues"],
    "default_enabled": true
}
