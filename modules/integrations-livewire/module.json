{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "integrations-livewire",
  "display_name": "Integrations Livewire",
  "description": "Integrations livewire presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\IntegrationsLivewire\\IntegrationsLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/integrations": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.integrations.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Bounded livewire presentation for Integrations",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}
