{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "integrations-api",
  "display_name": "Integrations Api",
  "description": "Integrations api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\IntegrationsApi\\IntegrationsApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/integrations": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.integrations.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for Integrations",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

