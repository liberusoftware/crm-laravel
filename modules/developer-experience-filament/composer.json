{
  "name": "liberusoftware/developer-experience-filament",
  "description": "Developer Experience filament presentation adapter.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "filament/filament": "^5.1",
    "liberusoftware/developer-experience": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\DeveloperExperienceFilament\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "developer-experience-filament"
    },
    "support": {
      "source": "https://github.com/liberusoftware/module-developer-experience-filament"
    }
  },
  "version": "1.0.1",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\DeveloperExperienceFilament\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.7",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
