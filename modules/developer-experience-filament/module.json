{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "developer-experience-filament",
  "display_name": "Developer Experience Filament",
  "description": "Developer Experience filament presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\DeveloperExperienceFilament\\DeveloperExperienceFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/developer-experience": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.developer-experience.filament"
  ],
  "default_enabled": true,
  "features": [
    "Bounded filament presentation for Developer Experience",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ],
  "presentation": {
    "filament": {
      "admin": [
        "Liberu\\Foundation\\DeveloperExperienceFilament\\DeveloperExperienceFilamentPlugin"
      ]
    }
  }
}
