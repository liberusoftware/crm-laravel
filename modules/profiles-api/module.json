{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "profiles-api",
  "display_name": "Profiles Api",
  "description": "Profiles api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\ProfilesApi\\ProfilesApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/profiles": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.profiles.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for Profiles",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

