{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "application-api",
  "display_name": "Application Core Api",
  "description": "Application Core api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\ApplicationApi\\ApplicationApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/application": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.application.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for Application Core",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

