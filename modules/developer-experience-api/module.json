{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "developer-experience-api",
  "display_name": "Developer Experience Api",
  "description": "Developer Experience api presentation adapter.",
  "version": "1.0.0",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\DeveloperExperienceApi\\DeveloperExperienceApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/developer-experience": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.developer-experience.api"
  ],
  "default_enabled": true,
  "features": [
    "Bounded api presentation for Developer Experience",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}

