{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "import-export-filament",
  "display_name": "Import and Export Filament",
  "description": "Import and Export filament presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\ImportExportFilament\\ImportExportFilamentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/import-export": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.import-export.filament"
  ],
  "default_enabled": true,
  "features": [
    "Bounded filament presentation for Import and Export",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ],
  "presentation": {
    "filament": {
      "admin": [
        "Liberu\\Foundation\\ImportExportFilament\\ImportExportFilamentPlugin"
      ]
    }
  }
}
