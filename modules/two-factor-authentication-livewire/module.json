{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "two-factor-authentication-livewire",
  "display_name": "Two-Factor Authentication Livewire",
  "description": "Two-Factor Authentication livewire presentation adapter.",
  "version": "1.0.1",
  "category": "presentation",
  "provider": "Liberu\\Foundation\\TwoFactorAuthenticationLivewire\\TwoFactorAuthenticationLivewireServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/two-factor-authentication": "^1.0"
    }
  },
  "suggests": [],
  "capabilities": [
    "foundation.two-factor-authentication.livewire"
  ],
  "default_enabled": true,
  "features": [
    "Bounded livewire presentation for Two-Factor Authentication",
    "Authorization delegated to the matching core module",
    "Accessible loading, empty, denied, and failure states"
  ]
}
